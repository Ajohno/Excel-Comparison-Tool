{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "echo",
            "type": "shell",
            "command": "echo Hello",
            "options": {
                "statusbar": {
                    "hide" : true
                }
            }
            
        },
        // Run the Excel Comparison Tool
        {
            "label": "Run Excel Comparison Tool",
            "type": "shell",
            "command": "python3.13.exe",
            "options": {
                "statusbar": {
                    "label" : "$(play) Run Excel Comparison Tool"
                }
            },
            "args": [
                "excel_cleaner_layered.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // Run pytest with coverage
        {
            "label": "Run Pytest",
            "type": "shell",
            "command": "python3.13.exe -m pytest -s -v",
            "options": {
                "statusbar": {
                    "label" : "$(bug) Run Pytest"
                }
                }
        }
        
    ]
}